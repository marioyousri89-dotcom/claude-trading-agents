# Who may run the scripts (comma-separated). Required: an empty list denies everyone.
TRADING_GATE_ALLOWED=github:your-username,google:you@example.com

# GitHub OAuth App with "Enable Device Flow" ticked (no secret needed).
GITHUB_CLIENT_ID=

# Google OAuth client of type "TVs and Limited Input devices".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional
# TRADING_GATE_SESSION_HOURS=12
# TRADING_GATE_SESSION_FILE=~/.config/claude-trading-agents/session.json

# JARVIS (the voice assistant at /jarvis)
# JARVIS_PASSPHRASE=a phrase only you know
# ANTHROPIC_API_KEY=           optional, gives her a Claude brain
# JARVIS_MODEL=claude-opus-5-5
# JARVIS_UNLOCK_HOURS=12

# Real platforms. Every platform runs in paper mode; real-money orders are locked in code.
# POLYMARKET_MODE=paper
# ETORO_MODE=paper
# ETORO_API_KEY=
# ETORO_USER_KEY=
# MT5_MODE=demo                MetaTrader 5 demo account (Windows, MetaTrader5 package)
# MT5_LOGIN=
# MT5_PASSWORD=
# MT5_SERVER=
# MOOMOO_MODE=demo             moomoo paper account through the OpenD gateway
# MOOMOO_HOST=127.0.0.1
# MOOMOO_PORT=11111
